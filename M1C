#include <bits/stdc++.h>
using namespace std;

class M1C{
	private: 
	   int spt;
	   int a[200];
	public:
		void nhap();
		void xuat();
		int timkiem(int x);
		void sapxep();
			
};

void M1C::nhap(){
	cout <<"So phan tu :";cin>>spt;
	for (int i = 0 ;i < spt ; i++){
		cout <<"a["<<i<<"J = ";
		cin >> a[i];
		
	}
}

void M1C::xuat(){
	for (int i = 0;i<spt;i++)
	    cout << a[i] << "\t";
	cout<<endl;
}

int M1C::timkiem(int x){
	int k = -1;
	for (int i = 0;i < spt; i++)
	    if (a[i] == x)
	       k = i;
	return k;
}

void M1C::sapxep(){
	int i,j;
	for(i = 0 ; i < spt - 1 ;i++){
		for (j = i + 1 ; j < spt ; j++){
			if (a[i] > a[j]){
			   int y = a[i];
			   a[i] = a[j];
			   a[j] = y;
		   }
	   }
   }
}
int main (){
	M1C x;
	x.nhap();
	x.xuat();
	
	int t;
	cout <<"Nhap phan tu can tim kiem : ";
	cin >> t;
	int vt = x.timkiem(t);
	
	if (vt == -1)
	   cout<<"Khong co phan tu" << t << "trong mang";
	else
       cout << "Phan tu " << t << " nam o vi tri " << vt;
    
    cout << "Phan tu sap xep tang dan la \n";
    x.sapxep();
    x.xuat();
    return 0;
    }
